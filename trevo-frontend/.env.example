# Trevo Frontend Environment Configuration

# Frappe Backend URL (server-side, used by BFF proxy routes)
FRAPPE_BACKEND_URL=http://localhost:8000

# Frappe Base URL (client-side, for direct references if needed)
NEXT_PUBLIC_FRAPPE_BASE_URL=http://localhost:8000

# Next.js app base URL (used for absolute links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# API base URL override (useful for deployment behind a reverse proxy)
NEXT_PUBLIC_API_BASE=

# Google Maps API key (enables GeolocationField)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Next.js environment (do not set manually)
NODE_ENV=development
