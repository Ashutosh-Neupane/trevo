# ============================================================
# Trevo Frontend — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# cp .env.example .env.local
# ============================================================

# ---- Frappe Backend ----
# The URL of the Frappe backend server
FRAPPE_BACKEND_URL=http://localhost:8000

# ---- Next.js ----
# The URL where the Next.js app runs (used for CORS, callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Optional: Sentry Error Tracking ----
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ---- Optional: Google Maps API Key ----
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# ---- Optional: Feature Flags ----
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_CHAT=false

# ---- Docker Build ----
# Set to "true" when building Docker image for standalone output
# DOCKER_BUILD=true
